#!/usr/bin/env python3
"""Browse branch changes in Vim with a left-hand quickfix sidebar."""

import argparse
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import tempfile

VERSION = "0.1.0"


def git(*args, cwd=None):
    result = subprocess.run(
        ["git", *args], cwd=cwd, stdout=subprocess.PIPE, stderr=subprocess.PIPE
    )
    if result.returncode:
        message = result.stderr.decode(errors="replace").strip()
        raise RuntimeError(message or "Git command failed")
    return result.stdout


def collect_changes(branch, exclude=None):
    root = Path(os.fsdecode(git("rev-parse", "--show-toplevel")).rstrip("\n"))
    # Resolve the name first so branch names cannot be interpreted as options.
    target = git("rev-parse", "--verify", "--end-of-options", branch + "^{commit}", cwd=root)
    base = git("merge-base", "HEAD", target.decode().strip(), cwd=root).decode().strip()
    paths = git("diff", "--name-only", "-z", "--diff-filter=d", base, "--", cwd=root)
    names = list(dict.fromkeys(os.fsdecode(p) for p in paths.split(b"\0") if p))
    if exclude:
        names = [name for name in names if not exclude.search(name)]
    return root, base, names


def vim_script(width):
    return f"""set noequalalways
let g:gitgutter_diff_base = $GITVIEW_BASE
call setqflist([], ' ', json_decode(join(readfile($GITVIEW_ITEMS), "\\n")))
silent cfirst
vertical copen
wincmd H
execute 'vertical resize ' . max([1, &columns * {width} / 100])
setlocal winfixwidth
"""


def open_vim(editor, root, base, names, branch, width):
    executable = shutil.which(editor)
    if not executable:
        raise RuntimeError(f"Vim executable not found: {editor}")
    with tempfile.TemporaryDirectory(prefix="gitview-") as temporary:
        directory = Path(temporary)
        items_path = directory / "items.json"
        script_path = directory / "open.vim"
        items_path.write_text(json.dumps({
            "title": f"gitview: {branch}",
            "items": [{"filename": str(root / name), "lnum": 1} for name in names],
        }), encoding="utf-8")
        script_path.write_text(vim_script(width), encoding="utf-8")
        environment = dict(os.environ, GITVIEW_ITEMS=str(items_path), GITVIEW_BASE=base)
        return subprocess.run(
            [executable, "-S", str(script_path)], cwd=root, env=environment
        ).returncode


def percentage(value):
    try:
        number = int(value)
    except ValueError:
        raise argparse.ArgumentTypeError("width must be an integer") from None
    if not 1 <= number <= 80:
        raise argparse.ArgumentTypeError("width must be between 1 and 80")
    return number


def main(argv=None):
    parser = argparse.ArgumentParser(
        description="Browse tracked changes since a branch's merge base in Vim."
    )
    parser.add_argument("branch", nargs="?", default="dev", help="base branch (default: dev)")
    parser.add_argument("-x", "--exclude", metavar="REGEX", help="exclude matching relative paths")
    parser.add_argument("--width", type=percentage, default=20, help="sidebar width percentage (default: 20)")
    parser.add_argument("--vim", default="vim", metavar="EXECUTABLE", help="Vim executable (default: vim)")
    parser.add_argument("--list", action="store_true", help="print paths without opening Vim")
    parser.add_argument("-0", "--null", action="store_true", help="use NUL separators with --list")
    parser.add_argument("--version", action="version", version=f"gitview {VERSION}")
    args = parser.parse_args(argv)
    if args.null and not args.list:
        parser.error("--null requires --list")
    try:
        exclude = re.compile(args.exclude) if args.exclude else None
    except re.error as error:
        parser.error(f"invalid exclusion regex: {error}")
    try:
        root, base, names = collect_changes(args.branch, exclude)
        if args.list:
            separator = b"\0" if args.null else b"\n"
            for name in names:
                sys.stdout.buffer.write(os.fsencode(name) + separator)
            return 0
        if not names:
            print("No matching tracked changes.")
            return 0
        return open_vim(args.vim, root, base, names, args.branch, args.width)
    except (RuntimeError, OSError) as error:
        print(f"gitview: {error}", file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    sys.exit(main())
